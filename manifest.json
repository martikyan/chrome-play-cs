{
  "manifest_version": 3,
  "name": "CS Play Macro & Launcher",
  "version": "1.5.0",
  "description": "Binds keys for play-cs.com",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.play-cs.com/*", "*://*.cs-online.club/*"],
      "js": ["settings.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": ["activeTab", "storage", "nativeMessaging", "tabs"],
  "web_accessible_resources": [
    {
      "resources": [
        "nintendo_switch.mp3"
      ],
      "matches": ["*://*.play-cs.com/*", "*://*.cs-online.club/*"]
    }
  ]
}
